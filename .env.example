# Server Configuration
PORT=3001
NODE_ENV=production

# MongoDB Connection (REQUIRED - use MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/streamvault

# Download Settings
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT_DOWNLOADS=3

# YouTube cookie auth - upload cookies via POST /api/download/cookies instead
# COOKIES_FILE=./cookies.txt

# YouTube Data Sync ID (required for PO token generation with some accounts)
# Get this from browser devtools: Application > Cookies > youtube.com > SAPISID
# Then pass as: --extractor-args youtube:data_sync_id=XXX
# YOUTUBE_DATA_SYNC_ID=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT & Auth (CHANGE THIS in production)
JWT_SECRET=change-this-to-a-random-secret-key

# Email (optional - for forgot password)
EMAIL_ENABLED=false
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM=StreamVault <noreply@streamvault.com>
# FRONTEND_URL=https://your-app.onrender.com
YOUTUBE_DATA_SYNC_ID=FofnBA_cIm3tFqYL/A2aqdMBXsQQ4l7Q0R